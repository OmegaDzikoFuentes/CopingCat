<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= @cat.name %></h1>
    <div class="flex gap-2">
      <%= link_to "✏️ Edit", edit_cat_path(@cat), class: "bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600" %>
      <%= button_to "🗑️ Delete", @cat, method: :delete, 
                    data: { confirm: "Are you sure?" }, 
                    class: "bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Cat Preview -->
    <div class="bg-white rounded-xl shadow-lg p-6">
      <div class="h-96 bg-gray-100 rounded-lg mb-4 flex items-center justify-center">
        <!-- Placeholder for 3D cat preview -->
        <div class="text-gray-400 text-center">
          <span class="text-6xl">😺</span>
          <p>3D Preview of <%= @cat.name %></p>
        </div>
      </div>
      
      <div class="space-y-4">
        <div>
          <h3 class="font-semibold text-lg">Model Information</h3>
          <p><span class="text-gray-600">Filename:</span> <%= @cat.model_filename %></p>
          <p><span class="text-gray-600">Category:</span> <%= @cat.category %></p>
          <p><span class="text-gray-600">Customizable:</span> <%= @cat.customizable ? 'Yes' : 'No' %></p>
        </div>
        
        <% if @cat.customizable %>
          <%= link_to "Customize Appearance", customize_cat_path(@cat), 
              class: "bg-purple-500 text-white px-4 py-2 rounded hover:bg-purple-600" %>
        <% end %>
      </div>
    </div>

    <div class="mt-8 bg-indigo-50 rounded-xl p-6">
    <h3 class="font-bold text-xl text-indigo-800 mb-4">Try Breathing Exercise</h3>
    <p class="mb-4">Practice deep breathing with <%= @cat.name %> as your companion</p>
    <%= link_to "Start Breathing Exercise", game_breathing_path(cat_id: @cat.id), 
        class: "bg-indigo-500 text-white px-6 py-3 rounded-lg hover:bg-indigo-600 font-semibold" %>
  </div>
    
    <!-- Actions -->
    <div class="space-y-6">
      <div class="bg-blue-50 rounded-xl p-6">
        <h3 class="font-bold text-xl text-blue-800 mb-4">Try Breathing Exercise</h3>
        <p class="mb-4">Practice deep breathing with <%= @cat.name %> as your companion</p>
        <%= link_to "Start Breathing Exercise", game_breathing_path(cat_id: @cat.id), 
            class: "bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 font-semibold" %>
      </div>
      
      <div class="bg-green-50 rounded-xl p-6">
        <h3 class="font-bold text-xl text-green-800 mb-4">Emotion Exploration</h3>
        <p class="mb-4">Explore your feelings with <%= @cat.name %></p>
        <%= link_to "Start Emotion Mapping", game_emotion_mapping_path(cat_id: @cat.id), 
            class: "bg-green-500 text-white px-6 py-3 rounded-lg hover:bg-green-600 font-semibold" %>
      </div>
      
      <div class="bg-white border rounded-xl p-6">
        <%= link_to "← Back to All Cats", cats_path, class: "text-blue-500 hover:text-blue-700" %>
      </div>
    </div>
  </div>
</div>